{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avonera48",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  // Build the app before every deploy/upload, so CI (Workers Builds) does not
  // depend on a build command being configured in the dashboard.
  "build": { "command": "npm run build" },
  // The Vite build output is served as static assets. Unknown paths fall back
  // to index.html so client-side routes (e.g. /dashboard/keys) resolve.
  // Only /api/* and /media/* reach the Worker script first (health, data and image proxy).
  // The API key is a secret: `npx wrangler secret put DATA_API_KEY`.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "JKT48CONNECT_APP_URL": "https://jkt48connect.com",
    "JKT48CONNECT_SYNC_URL": "https://jkt48connect.com/api/public/avonera/sync"
  },
  // Accounts, sessions and profile photos.
  "kv_namespaces": [
    {
      "binding": "AUTH",
      "id": "941c691dc7b64a8a88dc596fa2c441ce"
    }
  ],
  // Shop, memberships and chat. Tables are created on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "a77ae33d-c841-497c-b24a-b3d9dcbb9a22"
    }
  ]
}
